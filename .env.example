# =====================================================================
# SMART FYP ADMIN PORTAL — PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# Institution: University of Transport and Communications (UTC)
# =====================================================================

# ---------------------------------------------------------------------
# FRONTEND (Vercel Project Settings -> Environment Variables)
# ---------------------------------------------------------------------
# Set the base URL pointing to the deployed Django Admin backend API
VITE_API_BASE_URL=https://smart-fyp-admin-backend.onrender.com/app

# ---------------------------------------------------------------------
# BACKEND (Render / Railway / VPS Environment Variables)
# ---------------------------------------------------------------------
# Security Key (Generate a random 64-char string for production)
SECRET_KEY=your_production_secure_secret_key_min_64_characters

# Debug mode (MUST be False in production)
DEBUG=False

# Allowed Hostnames (Comma-separated)
ALLOWED_HOSTS=smart-fyp-admin-backend.onrender.com,fyp-admin.utc.edu.vn,localhost,127.0.0.1

# Database Connection (Neon PostgreSQL connection string)
DATABASE_URL=postgres://user:password@ep-cool-host.neon.tech/smart_fyp?sslmode=require

# CORS & CSRF Trusted Origins (Frontend Vercel domain)
CORS_ALLOWED_ORIGINS=https://smart-fyp-admin.vercel.app,http://localhost:5174
CSRF_TRUSTED_ORIGINS=https://smart-fyp-admin.vercel.app,http://localhost:5174

# Admin Registration Security Secret
ADMIN_REGISTRATION_SECRET=utc-smart-fyp-admin-secret-key-2026

# SSL & Security Headers
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
