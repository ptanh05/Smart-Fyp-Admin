# Server Security & Host Config
SECRET_KEY=production_secret_key_string_min_64_chars
DEBUG=False
ALLOWED_HOSTS=smart-fyp-admin-backend.onrender.com,localhost,127.0.0.1

# Shared Database (Neon PostgreSQL)
DATABASE_URL=postgres://user:password@ep-old-pine-azxhp8n7.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# CORS & CSRF Trusted Origins (Vercel Frontend Domain)
CORS_ALLOWED_ORIGINS=https://smart-fyp-admin.vercel.app,http://localhost:5174
CSRF_TRUSTED_ORIGINS=https://smart-fyp-admin.vercel.app,http://localhost:5174

# Security Hardening Flags
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
